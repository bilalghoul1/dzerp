  @@unique([companyId, number])
  @@index([clientId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([invoiceId])
  @@index([issuedAt])
  @@index([createdById])
}

model CreditNoteLine {
  id           String     @id @default(uuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  productId    String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  lineNumber     Int          @default(1)
  kind           DocumentLineKind  @default(PRODUCT)
  label          String
  unit           String?
  quantity     Decimal    @default(1)
  unitPrice    Decimal    @default(0)
  discountPct  Decimal    @default(0)
  taxPct       Decimal    @default(0)
  amountHt     Decimal    @default(0)
  amountTva    Decimal    @default(0)
  amountTtc    Decimal    @default(0)

  @@index([creditNoteId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Achats
// ---------------------------------------------------------------------------

model PurchaseRequest {
  id          String         @id @default(uuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      String
  status      DocumentStatus @default(DRAFT)
  clientId    String? // legacy shared-party reference (nullable); see supplierId
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  issuedById  String?
  issuedBy    User?          @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt    DateTime       @default(now())
  neededAt    DateTime?
  priority    String? // LOW | MEDIUM | HIGH
  currency    String         @default("DZD")
  notes       String?
  totalHt     Decimal        @default(0)
  totalTva    Decimal        @default(0)
  totalTtc    Decimal        @default(0)
  exchangeRate Decimal       @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?
  updatedById String?
  meta        Json?

  lines PurchaseRequestLine[]

  @@unique([companyId, number])
  @@index([clientId])
  @@index([supplierId])
  @@index([branchId])
  @@index([status])
  @@index([issuedAt])
  @@index([createdById])
}

model PurchaseRequestLine {
  id                String          @id @default(uuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  lineNumber        Int             @default(1)
  kind              DocumentLineKind @default(PRODUCT)
  label             String
  unit              String?
  quantity          Decimal         @default(1)
  unitPrice         Decimal         @default(0)
  discountPct       Decimal         @default(0)
  taxPct            Decimal         @default(0)
  amountHt          Decimal         @default(0)
  amountTva         Decimal         @default(0)
  amountTtc         Decimal         @default(0)

  @@index([purchaseRequestId])
  @@index([productId])
}

model PurchaseOrder {
  id           String         @id @default(uuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number       String
  status       DocumentStatus @default(DRAFT)
  clientId     String? // legacy shared-party reference (nullable); see supplierId
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  issuedById   String?
  issuedBy     User?          @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt     DateTime       @default(now())
  deliveryDate DateTime?
  currency     String         @default("DZD")
  notes        String?
  totalHt      Decimal        @default(0)
  totalTva     Decimal        @default(0)
  totalTtc     Decimal        @default(0)
  exchangeRate Decimal        @default(1)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String?
  updatedById  String?
  meta         Json?

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([companyId, number])
  @@index([clientId])
  @@index([supplierId])
  @@index([branchId])
  @@index([status])
  @@index([issuedAt])
  @@index([createdById])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  lineNumber      Int           @default(1)
  kind            DocumentLineKind @default(PRODUCT)
  label           String
