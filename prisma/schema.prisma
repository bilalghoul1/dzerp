generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id                  String               @id @default(uuid())
  code                String
  name                String
  nameAr              String?
  type                BranchType           @default(DIRECTION)
  city                String?
  address             String?
  phone               String?
  email               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdById         String?
  updatedById         String?
  ai                  String?
  commune             String?
  country             String?
  manager             String?
  nif                 String?
  nis                 String?
  postalCode          String?
  rc                  String?
  wilaya              String?
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultBranchFor    Company?             @relation("CompanyDefaultBranch")
  creditNotes         CreditNote[]
  customerOrders      CustomerOrder[]
  deliveryNotes       DeliveryNote[]
  departments         Department[]         @relation("DepartmentBranch")
  employees           Employee[]           @relation("EmployeeBranch")
  employmentContracts EmploymentContract[] @relation("ContractBranch")
  goodsReceipts       GoodsReceipt[]
  invoices            Invoice[]
  payments            Payment[]
  positions           Position[]           @relation("PositionBranch")
  proformas           Proforma[]
  purchaseOrders      PurchaseOrder[]
  purchaseRequests    PurchaseRequest[]
  quotations          Quotation[]
  salesOrders         SalesOrder[]
  sessions            Session[]
  supplierInvoices    SupplierInvoice[]
  users               User[]
  userCompanies       UserCompany[]        @relation("UserCompanyDefaultBranch")
  warehouses          Warehouse[]
  workCenters         WorkCenter[]         @relation("WorkCenterBranch")

  @@unique([companyId, code])
  @@index([type])
  @@index([city])
  @@index([wilaya])
}

model Country {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nameAr      String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model LegalForm {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nameAr      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model BusinessSector {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nameAr      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model PaymentMethod {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  nameAr      String?
  days        Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  updatedById String?
  payments    Payment[]

  @@index([isActive])
}

model Wilaya {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  nameAr    String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  communes  Commune[]

  @@index([isActive])
}

model Commune {
  id         String   @id @default(uuid())
  code       String   @unique
  wilayaCode String
  name       String
  nameAr     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  wilaya     Wilaya   @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)

  @@index([wilayaCode])
  @@index([isActive])
}

model Bank {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nameAr      String?
  swift       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model User {
  id                       String             @id @default(uuid())
  username                 String             @unique
  email                    String?            @unique
  passwordHash             String
  fullName                 String?
  title                    String?
  status                   UserStatus         @default(ACTIVE)
  lastLoginAt              DateTime?
  branchId                 String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  createdById              String?
  updatedById              String?
  mustChangePassword       Boolean            @default(false)
  activity                 ActivityEvent[]
  auditLogs                AuditLog[]
  companyDrafts            CompanyDraft?
  issuedCreditNotes        CreditNote[]
  issuedCustomerOrders     CustomerOrder[]
  issuedDeliveryNotes      DeliveryNote[]
  decidedApprovals         DocumentApproval[] @relation("DocumentApprovalApprover")
  requestedApprovals       DocumentApproval[] @relation("DocumentApprovalRequestedBy")
  createdDocumentRelations DocumentRelation[]
  employees                Employee[]
  files                    FileAsset[]
  issuedGoodsReceipts      GoodsReceipt[]
  issuedInvoices           Invoice[]
  journalEntries           JournalEntry[]
  issuedPayments           Payment[]
  issuedProformas          Proforma[]
  issuedPurchaseOrders     PurchaseOrder[]
  issuedPurchaseRequests   PurchaseRequest[]
  issuedQuotations         Quotation[]
  issuedSalesOrders        SalesOrder[]
  sessions                 Session[]
  settings                 Setting[]
  issuedSupplierInvoices   SupplierInvoice[]
  branch                   Branch?            @relation(fields: [branchId], references: [id])
  userCompanies            UserCompany[]
  roles                    UserRole[]
  managedWarehouses        Warehouse[]

  @@index([branchId])
  @@index([status])
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  nameAr      String?
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignments RoleAssignment[]
  permissions RolePermission[]
  users       UserRole[]

  @@index([isSystem])
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  module      String
  name        String
  nameAr      String?
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Company {
  id                  String                    @id @default(uuid())
  code                String                    @unique
  name                String
  nameAr              String?
  legalName           String?
  legalForm           String?
  activity            String?
  taxId               String?
  rc                  String?
  nis                 String?
  ai                  String?
  vatNumber           String?
  address             String?
  country             String?
  wilaya              String?
  commune             String?
  postalCode          String?
  phone               String?
  email               String?
  website             String?
  currency            String                    @default("DZD")
  fiscalYear          Int?
  isDefault           Boolean                   @default(false)
  isActive            Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  createdById         String?
  updatedById         String?
  bank                String?
  bankAccount         String?
  bankAgency          String?
  capital             Decimal?
  commercialName      String?
  defaultBranchId     String?                   @unique
  deletedAt           DateTime?
  deletedById         String?
  emailFooter         String?
  establishedAt       DateTime?
  expiryDate          DateTime?
  iban                String?
  invoiceFooter       String?
  language            String                    @default("fr")
  logoKey             String?
  mobile              String?
  notes               String?
  paymentTerms        String?
  primaryColor        String?
  printFormat         String                    @default("A4")
  printHeader         String?
  printMargins        Json?
  qrEnabled           Boolean                   @default(false)
  rib                 String?
  secondaryActivity   String?
  secondaryColor      String?
  signatureKey        String?
  stampKey            String?
  status              CompanyStatus             @default(ACTIVE)
  swift               String?
  type                String?
  accounts            Account[]
  activityEvents      ActivityEvent[]
  auditLogs           AuditLog[]
  bankReconciliations BankReconciliation[]
  branches            Branch[]
  brands              Brand[]
  defaultBranch       Branch?                   @relation("CompanyDefaultBranch", fields: [defaultBranchId], references: [id])
  creditNotes         CreditNote[]
  customers           Customer[]
  customerOrders      CustomerOrder[]
  deliveryNotes       DeliveryNote[]
  departments         Department[]
  documentApprovals   DocumentApproval[]
  documentRelations   DocumentRelation[]
  documentSeries      DocumentSeries[]
  employees           Employee[]
  employmentContracts EmploymentContract[]
  fileAssets          FileAsset[]
  fiscalPeriods       FiscalPeriod[]
  fixedAssets         FixedAsset[]
  goodsReceipts       GoodsReceipt[]
  inventoryMovements  InventoryMovement[]
  invoices            Invoice[]
  irgBrackets         IrgBracket[]
  jobTitles           JobTitle[]
  journalEntries      JournalEntry[]
  machines            Machine[]
  manufacturers       Manufacturer[]
  payments            Payment[]
  payrollRuns         PayrollRun[]
  positions           Position[]
  products            Product[]
  boms                ProductBOM[]
  productCategories   ProductCategory[]
  productionOrders    ProductionOrder[]
  proformas           Proforma[]
  purchaseOrders      PurchaseOrder[]
  purchaseRequests    PurchaseRequest[]
  quotations          Quotation[]
  salarySlips         SalarySlip[]
  salesOrders         SalesOrder[]
  sessions            Session[]
  socialConfig        SocialContributionConfig?
  suppliers           Supplier[]
  supplierInvoices    SupplierInvoice[]
  taxDeclarations     TaxDeclaration[]
  userCompanies       UserCompany[]
  warehouses          Warehouse[]
  workCenters         WorkCenter[]

  @@index([isActive])
  @@index([isDefault])
  @@index([status])
  @@index([deletedAt])
}

/// Brouillon de création de société (assistant 9 étapes, Phase 5.5).
/// Un seul brouillon actif par utilisateur : sauvegarde partielle des étapes.
model CompanyDraft {
  id        String   @id @default(uuid())
  userId    String   @unique
  step      Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

/// Adhésion d'un utilisateur à une société (Phase 5.3).
/// Un utilisateur peut appartenir à plusieurs sociétés ; une seule adhésion
/// par couple (utilisateur, société) ; exactement une adhésion par défaut par
/// utilisateur.
model UserCompany {
  id              String           @id @default(uuid())
  userId          String
  companyId       String
  active          Boolean          @default(true)
  isDefault       Boolean          @default(false)
  joinedAt        DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  defaultBranchId String?
  roleAssignments RoleAssignment[]
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultBranch   Branch?          @relation("UserCompanyDefaultBranch", fields: [defaultBranchId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([active])
}

/// Rôle attribué à une adhésion société (Phase 5.3).
/// Remplace l'autorisation directe par `UserRole` (rôle global) dans la société
/// active. Prêt pour les permissions temporaires et la délégation (`expiresAt`).
model RoleAssignment {
  id            String      @id @default(uuid())
  userCompanyId String
  roleId        String
  active        Boolean     @default(true)
  assignedBy    String?
  assignedAt    DateTime    @default(now())
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userCompany   UserCompany @relation(fields: [userCompanyId], references: [id], onDelete: Cascade)

  @@unique([userCompanyId, roleId])
  @@index([roleId])
  @@index([active])
}

model Session {
  id              String    @id @default(uuid())
  token           String    @unique
  userId          String
  ip              String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  activeBranchId  String?
  activeCompanyId String?
  activeBranch    Branch?   @relation(fields: [activeBranchId], references: [id])
  activeCompany   Company?  @relation(fields: [activeCompanyId], references: [id])
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeCompanyId])
  @@index([activeBranchId])
}

model Setting {
  id          String      @id @default(uuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  description String?
  isPublic    Boolean     @default(false)
  updatedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  updatedBy   User?       @relation(fields: [updatedById], references: [id])

  @@index([isPublic])
}

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  entity    String
  entityId  String?
  actorId   String?
  ip        String?
  userAgent String?
  changes   Json?
  createdAt DateTime    @default(now())
  companyId String?
  actor     User?       @relation(fields: [actorId], references: [id])
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model ActivityEvent {
  id        String       @id @default(uuid())
  type      ActivityType
  actorId   String?
  entity    String
  entityId  String?
  title     String
  titleAr   String?
  meta      Json?
  createdAt DateTime     @default(now())
  companyId String?
  actor     User?        @relation(fields: [actorId], references: [id])
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model FileAsset {
  id           String   @id @default(uuid())
  originalName String
  storageKey   String   @unique
  mimeType     String
  size         Int
  kind         FileKind @default(ATTACHMENT)
  entity       String
  entityId     String?
  createdById  String?
  createdAt    DateTime @default(now())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([entity, entityId])
  @@index([createdById])
  @@index([kind])
}

model Counter {
  id        String @id @default(uuid())
  key       String @unique
  prefix    String @default("")
  nextValue BigInt @default(1)
  padLength Int    @default(4)
  step      Int    @default(1)
}

model Client {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  nameAr           String?
  sector           String?
  email            String?
  phone            String?
  taxId            String?
  address          String?
  balance          Decimal           @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?
  deletedById      String?
  activity         String?
  ai               String?
  commercialName   String?
  commune          String?
  creditLimit      Decimal           @default(0)
  firstName        String?
  kind             PartyKind         @default(CUSTOMER)
  lastName         String?
  legalForm        String?
  legalName        String?
  nis              String?
  notes            String?
  paymentTerms     String?
  postalCode       String?
  rc               String?
  type             ClientType        @default(COMPANY)
  vatNumber        String?
  wilaya           String?
  creditNotes      CreditNote[]
  customerOrders   CustomerOrder[]
  deliveryNotes    DeliveryNote[]
  goodsReceipts    GoodsReceipt[]
  invoices         Invoice[]
  proformas        Proforma[]
  purchaseOrders   PurchaseOrder[]
  purchaseRequests PurchaseRequest[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  supplierInvoices SupplierInvoice[]

  @@index([name])
  @@index([kind])
  @@index([type])
  @@index([sector])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdById])
}

model Customer {
  id             String          @id @default(uuid())
  code           String
  type           ClientType      @default(COMPANY)
  name           String
  nameAr         String?
  firstName      String?
  lastName       String?
  legalName      String?
  commercialName String?
  legalForm      String?
  activity       String?
  sector         String?
  email          String?
  phone          String?
  taxId          String?
  rc             String?
  nis            String?
  ai             String?
  vatNumber      String?
  address        String?
  wilaya         String?
  commune        String?
  postalCode     String?
  paymentTerms   String?
  creditLimit    Decimal         @default(0)
  notes          String?
  balance        Decimal         @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  companyId      String
  creditNotes    CreditNote[]
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerOrders CustomerOrder[]
  deliveryNotes  DeliveryNote[]
  invoices       Invoice[]
  payments       Payment[]
  proformas      Proforma[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]

  @@unique([companyId, code])
  @@index([name])
  @@index([type])
  @@index([sector])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdById])
}

model Supplier {
  id                String            @id @default(uuid())
  code              String
  type              ClientType        @default(COMPANY)
  name              String
  nameAr            String?
  firstName         String?
  lastName          String?
  legalName         String?
  commercialName    String?
  legalForm         String?
  activity          String?
  sector            String?
  email             String?
  phone             String?
  taxId             String?
  rc                String?
  nis               String?
  ai                String?
  vatNumber         String?
  address           String?
  wilaya            String?
  commune           String?
  postalCode        String?
  paymentTerms      String?
  creditLimit       Decimal           @default(0)
  notes             String?
  balance           Decimal           @default(0)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?
  deletedById       String?
  companyId         String
  goodsReceipts     GoodsReceipt[]
  payments          Payment[]
  preferredProducts Product[]         @relation("ProductPreferredSupplier")
  productSuppliers  ProductSupplier[]
  purchaseOrders    PurchaseOrder[]
  purchaseRequests  PurchaseRequest[]
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierInvoices  SupplierInvoice[]

  @@unique([companyId, code])
  @@index([name])
  @@index([type])
  @@index([sector])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdById])
}

model Product {
  id                     String                  @id @default(uuid())
  sku                    String
  name                   String
  nameAr                 String?
  unit                   String?
  category               String?
  price                  Decimal                 @default(0)
  stock                  Int                     @default(0)
  stockMin               Int                     @default(0)
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  createdById            String?
  updatedById            String?
  deletedAt              DateTime?
  deletedById            String?
  allowNegativeStock     Boolean                 @default(false)
  barcode                String?
  brandId                String?
  categoryId             String?
  code                   String
  costPrice              Decimal                 @default(0)
  costingMethod          CostingMethod           @default(AVERAGE)
  description            String?
  height                 Decimal?
  internalReference      String?
  inventoryUnitId        String?
  isArchived             Boolean                 @default(false)
  length                 Decimal?
  manufacturerId         String?
  maximumQuantity        Decimal                 @default(0)
  meta                   Json?
  minimumQuantity        Decimal                 @default(0)
  minimumSellingPrice    Decimal                 @default(0)
  notes                  String?
  parentId               String?
  preferredSupplierId    String?
  purchasePrice          Decimal                 @default(0)
  purchaseUnitId         String?
  reorderPoint           Decimal                 @default(0)
  retailPrice            Decimal                 @default(0)
  salesUnitId            String?
  sellingPrice           Decimal                 @default(0)
  subcategoryId          String?
  trackInventory         Boolean                 @default(true)
  type                   ProductType             @default(PRODUCT)
  vatCategoryId          String?
  volume                 Decimal?
  weight                 Decimal?
  wholesalePrice         Decimal                 @default(0)
  width                  Decimal?
  companyId              String
  creditNoteLines        CreditNoteLine[]
  customerOrderLines     CustomerOrderLine[]
  deliveryNoteLines      DeliveryNoteLine[]
  goodsReceiptLines      GoodsReceiptLine[]
  inventoryMovements     InventoryMovement[]
  invoiceLines           InvoiceLine[]
  brand                  Brand?                  @relation(fields: [brandId], references: [id])
  productCategory        ProductCategory?        @relation("ProductCategory", fields: [categoryId], references: [id])
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryUnit          Unit?                   @relation("ProductInventoryUnit", fields: [inventoryUnitId], references: [id])
  manufacturer           Manufacturer?           @relation(fields: [manufacturerId], references: [id])
  parent                 Product?                @relation("ProductVariant", fields: [parentId], references: [id])
  children               Product[]               @relation("ProductVariant")
  preferredSupplier      Supplier?               @relation("ProductPreferredSupplier", fields: [preferredSupplierId], references: [id])
  purchaseUnit           Unit?                   @relation("ProductPurchaseUnit", fields: [purchaseUnitId], references: [id])
  salesUnit              Unit?                   @relation("ProductSalesUnit", fields: [salesUnitId], references: [id])
  productSubcategory     ProductCategory?        @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  vatCategory            VatCategory?            @relation(fields: [vatCategoryId], references: [id])
  attributeValues        ProductAttributeValue[]
  boms                   ProductBOM[]            @relation("ProductBOMProduct")
  bomItems               ProductBOMItem[]        @relation("ProductBOMItemProduct")
  productSuppliers       ProductSupplier[]
  productionConsumptions ProductionConsumption[] @relation("ProductionConsumptionProduct")
  productionOrders       ProductionOrder[]       @relation("ProductionOrderProduct")
  productionOrderItems   ProductionOrderItem[]   @relation("ProductionOrderItemProduct")
  productionOutputs      ProductionOutput[]      @relation("ProductionOutputProduct")
  proformaLines          ProformaLine[]
  purchaseOrderLines     PurchaseOrderLine[]
  purchaseRequestLines   PurchaseRequestLine[]
  quotationLines         QuotationLine[]
  salesOrderLines        SalesOrderLine[]
  supplierInvoiceLines   SupplierInvoiceLine[]

  @@unique([companyId, code])
  @@unique([companyId, sku])
  @@index([name])
  @@index([nameAr])
  @@index([type])
  @@index([barcode])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([brandId])
  @@index([manufacturerId])
  @@index([vatCategoryId])
  @@index([preferredSupplierId])
  @@index([parentId])
  @@index([deletedAt])
  @@index([createdById])
}

model ProductCategory {
  id                    String            @id @default(uuid())
  code                  String
  name                  String
  nameAr                String?
  parentId              String?
  isActive              Boolean           @default(true)
  sortOrder             Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  createdById           String?
  updatedById           String?
  companyId             String
  productsAsCategory    Product[]         @relation("ProductCategory")
  productsAsSubcategory Product[]         @relation("ProductSubcategory")
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent                ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children              ProductCategory[] @relation("ProductCategoryTree")

  @@unique([companyId, code])
  @@index([parentId])
  @@index([isActive])
}

model Brand {
  id          String    @id @default(uuid())
  code        String
  name        String
  nameAr      String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, code])
  @@index([isActive])
}

model Manufacturer {
  id          String    @id @default(uuid())
  code        String
  name        String
  nameAr      String?
  country     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, code])
  @@index([isActive])
}

model Unit {
  id                   String                @id @default(uuid())
  code                 String                @unique
  name                 String
  nameAr               String?
  symbol               String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdById          String?
  updatedById          String?
  inventoryUnits       Product[]             @relation("ProductInventoryUnit")
  purchaseUnits        Product[]             @relation("ProductPurchaseUnit")
  salesUnits           Product[]             @relation("ProductSalesUnit")
  bomItems             ProductBOMItem[]      @relation("ProductBOMItemUnit")
  productionOrderItems ProductionOrderItem[] @relation("ProductionOrderItemUnit")

  @@index([isActive])
}

model VatCategory {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  nameAr      String?
  rate        Decimal   @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  products    Product[]

  @@index([isActive])
}

model ProductAttribute {
  id          String                  @id @default(uuid())
  code        String                  @unique
  name        String
  nameAr      String?
  inputType   AttributeInputType      @default(TEXT)
  options     Json?
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  createdById String?
  updatedById String?
  values      ProductAttributeValue[]

  @@index([isActive])
}

model ProductAttributeValue {
  id          String           @id @default(uuid())
  productId   String
  attributeId String
  value       String
  createdAt   DateTime         @default(now())
  updatedById String?
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId])
}

model ProductSupplier {
  id            String   @id @default(uuid())
  productId     String
  supplierId    String
  supplierSku   String?
  supplierPrice Decimal  @default(0)
  leadTimeDays  Int?
  isPreferred   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedById   String?
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([supplierId])
}

model Warehouse {
  id                     String                  @id @default(uuid())
  code                   String
  name                   String
  description            String?
  branchId               String?
  address                String?
  managerId              String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  createdById            String?
  updatedById            String?
  deletedAt              DateTime?
  deletedById            String?
  nameAr                 String?
  companyId              String
  movements              InventoryMovement[]
  productionConsumptions ProductionConsumption[] @relation("ProductionConsumptionWarehouse")
  productionOrders       ProductionOrder[]       @relation("ProductionOrderWarehouse")
  productionOutputs      ProductionOutput[]      @relation("ProductionOutputWarehouse")
  branch                 Branch?                 @relation(fields: [branchId], references: [id])
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager                User?                   @relation(fields: [managerId], references: [id])
  locations              WarehouseLocation[]

  @@unique([companyId, code])
  @@index([branchId])
  @@index([managerId])
  @@index([deletedAt])
  @@index([createdById])
}

model WarehouseLocation {
  id          String                @id @default(uuid())
  warehouseId String
  parentId    String?
  type        WarehouseLocationType @default(LOCATION)
  code        String
  name        String
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  parent      WarehouseLocation?    @relation("WarehouseLocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    WarehouseLocation[]   @relation("WarehouseLocationTree")
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([parentId])
  @@index([type])
}

model InventoryMovement {
  id               String                @id @default(uuid())
  number           String
  type             InventoryMovementType
  productId        String
  warehouseId      String
  quantity         Decimal               @default(0)
  unitCost         Decimal?
  occurredAt       DateTime              @default(now())
  referenceDocType DocType?
  referenceDocId   String?
  referenceNumber  String?
  counterpartId    String?
  notes            String?
  meta             Json?
  createdById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  companyId        String
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product          Product               @relation(fields: [productId], references: [id])
  warehouse        Warehouse             @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, number])
  @@index([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([occurredAt])
  @@index([referenceDocId])
  @@index([createdById])
}

/// Nomenclature (BOM) d'un produit fini. Une entreprise peut avoir plusieurs
/// versions actives/inactives pour un même produit fini.
model ProductBOM {
  id               String            @id @default(uuid())
  code             String
  name             String
  nameAr           String?
  productId        String
  version          Int               @default(1)
  isActive         Boolean           @default(true)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  notes            String?
  companyId        String
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product          Product           @relation("ProductBOMProduct", fields: [productId], references: [id], onDelete: Cascade)
  items            ProductBOMItem[]
  productionOrders ProductionOrder[] @relation("ProductionOrderBOM")

  @@unique([companyId, code])
  @@index([productId])
  @@index([isActive])
}

model ProductBOMItem {
  id        String     @id @default(uuid())
  bomId     String
  productId String
  quantity  Decimal    @db.Decimal(18, 4)
  unitId    String?
  notes     String?
  sortOrder Int        @default(0)
  bom       ProductBOM @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product   Product    @relation("ProductBOMItemProduct", fields: [productId], references: [id])
  unit      Unit?      @relation("ProductBOMItemUnit", fields: [unitId], references: [id])

  @@index([bomId])
  @@index([productId])
}

/// Centre de charge (atelier / ligne de production).
model WorkCenter {
  id               String            @id @default(uuid())
  code             String
  name             String
  nameAr           String?
  description      String?
  isActive         Boolean           @default(true)
  companyId        String
  branchId         String?
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  machines         Machine[]
  productionOrders ProductionOrder[] @relation("ProductionOrderWorkCenter")
  branch           Branch?           @relation("WorkCenterBranch", fields: [branchId], references: [id])
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([branchId])
  @@index([isActive])
}

/// Machine rattachée à un centre de charge.
model Machine {
  id           String     @id @default(uuid())
  code         String
  name         String
  nameAr       String?
  workCenterId String
  capacity     Decimal?   @db.Decimal(18, 4)
  isActive     Boolean    @default(true)
  companyId    String
  branchId     String?
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workCenter   WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([workCenterId])
  @@index([isActive])
}

/// Ordre de fabrication (MRP). Le statut suit un workflow strict
/// (DRAFT → PLANNED → IN_PROGRESS → COMPLETED | CANCELLED).
model ProductionOrder {
  id           String                  @id @default(uuid())
  number       String
  productId    String
  bomId        String?
  plannedQty   Decimal                 @db.Decimal(18, 4)
  warehouseId  String
  workCenterId String?
  status       ProductionStatus        @default(DRAFT)
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  notes        String?
  companyId    String
  branchId     String?
  createdById  String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  consumptions ProductionConsumption[]
  bom          ProductBOM?             @relation("ProductionOrderBOM", fields: [bomId], references: [id])
  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product      Product                 @relation("ProductionOrderProduct", fields: [productId], references: [id])
  warehouse    Warehouse               @relation("ProductionOrderWarehouse", fields: [warehouseId], references: [id])
  workCenter   WorkCenter?             @relation("ProductionOrderWorkCenter", fields: [workCenterId], references: [id])
  items        ProductionOrderItem[]
  outputs      ProductionOutput[]

  @@unique([companyId, number])
  @@index([productId])
  @@index([status])
  @@index([bomId])
  @@index([warehouseId])
}

/// Département d'une société. Peut être rattaché à une succursale.
model Department {
  id                String               @id @default(uuid())
  companyId         String
  branchId          String?
  code              String
  name              String
  nameAr            String?
  description       String?
  /// Référence libre vers un employé futur (Phase 10.2) — pas de FK prématurée.
  managerEmployeeId String?
  isActive          Boolean              @default(true)
  archivedAt        DateTime?
  archivedById      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdById       String?
  updatedById       String?
  branch            Branch?              @relation("DepartmentBranch", fields: [branchId], references: [id])
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees         Employee[]
  contracts         EmploymentContract[]
  positions         Position[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
  @@index([isActive])
}

/// Intitulé de poste (ex: Comptable, Conducteur). Indépendant d'un département.
model JobTitle {
  id           String     @id @default(uuid())
  companyId    String
  code         String
  name         String
  nameAr       String?
  description  String?
  isActive     Boolean    @default(true)
  archivedAt   DateTime?
  archivedById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String?
  updatedById  String?
  employees    Employee[]
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  positions    Position[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
}

/// Poste réel : département + intitulé + succursale + effectif prévu.
model Position {
  id                String               @id @default(uuid())
  companyId         String
  departmentId      String
  jobTitleId        String
  branchId          String?
  code              String
  name              String
  nameAr            String?
  description       String?
  /// Effectif prévu sur le poste (optionnel).
  headcount         Int?                 @default(1)
  /// Référence libre vers un employé futur (Phase 10.2) — pas de FK prématurée.
  managerEmployeeId String?
  isActive          Boolean              @default(true)
  archivedAt        DateTime?
  archivedById      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdById       String?
  updatedById       String?
  employees         Employee[]
  contracts         EmploymentContract[]
  branch            Branch?              @relation("PositionBranch", fields: [branchId], references: [id])
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department        Department           @relation(fields: [departmentId], references: [id])
  jobTitle          JobTitle             @relation(fields: [jobTitleId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([branchId])
  @@index([isActive])
}

/// Employé — entité RH métier. Distinct de User (identité auth).
/// Employee.userId est nullable : un employé n'a pas forcément de compte système.
model Employee {
  id             String               @id @default(uuid())
  companyId      String
  branchId       String?
  code           String
  firstName      String
  lastName       String
  nameAr         String?
  email          String?
  phone          String?
  gender         String?
  birthDate      DateTime?
  hireDate       DateTime
  startDate      DateTime
  endDate        DateTime?
  status         EmployeeStatus       @default(ACTIVE)
  departmentId   String?
  positionId     String?
  jobTitleId     String?
  userId         String?
  address        String?
  cin            String?
  nss            String?
  bankAccount    String?
  iban           String?
  baseSalary     Decimal?             @db.Decimal(18, 4)
  currency       String               @default("DZD")
  isActive       Boolean              @default(true)
  archivedAt     DateTime?
  archivedById   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdById    String?
  updatedById    String?
  housingBonus   Decimal?             @db.Decimal(18, 4)
  otherBonus     Decimal?             @db.Decimal(18, 4)
  seniorityBonus Decimal?             @db.Decimal(18, 4)
  transportBonus Decimal?             @db.Decimal(18, 4)
  branch         Branch?              @relation("EmployeeBranch", fields: [branchId], references: [id])
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department     Department?          @relation(fields: [departmentId], references: [id])
  jobTitle       JobTitle?            @relation(fields: [jobTitleId], references: [id])
  position       Position?            @relation(fields: [positionId], references: [id])
  user           User?                @relation(fields: [userId], references: [id])
  contracts      EmploymentContract[]
  salarySlips    SalarySlip[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([positionId])
  @@index([jobTitleId])
  @@index([userId])
  @@index([status])
  @@index([isActive])
}

/// Contrat de travail — lié à un employé. Soft-archive uniquement.
model EmploymentContract {
  id             String         @id @default(uuid())
  companyId      String
  employeeId     String
  contractType   ContractType
  startDate      DateTime
  endDate        DateTime?
  positionId     String?
  departmentId   String?
  branchId       String?
  baseSalary     Decimal        @db.Decimal(18, 4)
  currency       String         @default("DZD")
  workingHours   Int?           @default(40)
  trialEndDate   DateTime?
  documentRef    String?
  status         ContractStatus @default(DRAFT)
  signedAt       DateTime?
  isActive       Boolean        @default(true)
  archivedAt     DateTime?
  archivedById   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  updatedById    String?
  housingBonus   Decimal?       @db.Decimal(18, 4)
  otherBonus     Decimal?       @db.Decimal(18, 4)
  seniorityBonus Decimal?       @db.Decimal(18, 4)
  transportBonus Decimal?       @db.Decimal(18, 4)
  branch         Branch?        @relation("ContractBranch", fields: [branchId], references: [id])
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department     Department?    @relation(fields: [departmentId], references: [id])
  employee       Employee       @relation(fields: [employeeId], references: [id])
  position       Position?      @relation(fields: [positionId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([positionId])
  @@index([departmentId])
  @@index([branchId])
  @@index([status])
  @@index([isActive])
}

/// Composants planifiés de l'ordre (copiés depuis le BOM au démarrage).
model ProductionOrderItem {
  id        String          @id @default(uuid())
  orderId   String
  productId String
  quantity  Decimal         @db.Decimal(18, 4)
  unitId    String?
  bomItemId String?
  order     ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation("ProductionOrderItemProduct", fields: [productId], references: [id])
  unit      Unit?           @relation("ProductionOrderItemUnit", fields: [unitId], references: [id])

  @@index([orderId])
  @@index([productId])
}

/// Consommation réelle de matière (impacte le stock via InventoryMovement).
model ProductionConsumption {
  id               String          @id @default(uuid())
  orderId          String
  productId        String
  warehouseId      String
  quantity         Decimal         @db.Decimal(18, 4)
  unitCost         Decimal?        @db.Decimal(18, 4)
  occurredAt       DateTime        @default(now())
  consumedById     String?
  notes            String?
  referenceDocId   String?
  referenceDocType String?
  order            ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation("ProductionConsumptionProduct", fields: [productId], references: [id])
  warehouse        Warehouse       @relation("ProductionConsumptionWarehouse", fields: [warehouseId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([warehouseId])
}

/// Sortie réelle de production (produit fini entrant au stock).
model ProductionOutput {
  id               String          @id @default(uuid())
  orderId          String
  productId        String
  warehouseId      String
  quantity         Decimal         @db.Decimal(18, 4)
  unitCost         Decimal?        @db.Decimal(18, 4)
  occurredAt       DateTime        @default(now())
  notes            String?
  producedById     String?
  referenceDocId   String?
  referenceDocType String?
  order            ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation("ProductionOutputProduct", fields: [productId], references: [id])
  warehouse        Warehouse       @relation("ProductionOutputWarehouse", fields: [warehouseId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([warehouseId])
}

model DocumentSeries {
  id          String   @id @default(uuid())
  key         String
  docType     DocType
  label       String
  labelAr     String?
  prefix      String   @default("")
  separator   String   @default("-")
  suffix      String   @default("")
  withYear    Boolean  @default(true)
  year        Int?
  nextValue   BigInt   @default(1)
  padLength   Int      @default(4)
  step        Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@unique([companyId, docType])
}

model DocumentApproval {
  id            String         @id @default(uuid())
  docType       DocType
  docId         String         @unique
  requestedById String?
  approverId    String?
  status        ApprovalStatus @default(PENDING)
  comment       String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  companyId     String
  approver      User?          @relation("DocumentApprovalApprover", fields: [approverId], references: [id])
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy   User?          @relation("DocumentApprovalRequestedBy", fields: [requestedById], references: [id])

  @@index([companyId])
  @@index([docType])
  @@index([status])
  @@index([approverId])
}

model Quotation {
  id           String          @id @default(uuid())
  number       String
  status       DocumentStatus  @default(DRAFT)
  clientId     String?
  branchId     String
  issuedById   String?
  issuedAt     DateTime        @default(now())
  validUntil   DateTime?
  currency     String          @default("DZD")
  notes        String?
  totalHt      Decimal         @default(0)
  totalTva     Decimal         @default(0)
  totalTtc     Decimal         @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdById  String?
  updatedById  String?
  customerId   String
  companyId    String
  exchangeRate Decimal         @default(1)
  meta         Json?
  branch       Branch          @relation(fields: [branchId], references: [id])
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id])
  issuedBy     User?           @relation(fields: [issuedById], references: [id])
  lines        QuotationLine[]
  salesOrders  SalesOrder[]

  @@unique([companyId, number])
  @@index([clientId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([issuedAt])
  @@index([createdById])
}

model QuotationLine {
  id          String           @id @default(uuid())
  quotationId String
  productId   String?
  lineNumber  Int              @default(1)
  label       String
  unit        String?
  quantity    Decimal          @default(1)
  unitPrice   Decimal          @default(0)
  discountPct Decimal          @default(0)
  taxPct      Decimal          @default(0)
  amountHt    Decimal          @default(0)
  amountTva   Decimal          @default(0)
  amountTtc   Decimal          @default(0)
  kind        DocumentLineKind @default(PRODUCT)
  product     Product?         @relation(fields: [productId], references: [id])
  quotation   Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([productId])
}

model SalesOrder {
  id            String           @id @default(uuid())
  number        String
  status        DocumentStatus   @default(DRAFT)
  clientId      String?
  branchId      String
  quotationId   String?
  issuedById    String?
  issuedAt      DateTime         @default(now())
  deliveryDate  DateTime?
  currency      String           @default("DZD")
  notes         String?
  totalHt       Decimal          @default(0)
  totalTva      Decimal          @default(0)
  totalTtc      Decimal          @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdById   String?
  updatedById   String?
  customerId    String
  companyId     String
  exchangeRate  Decimal          @default(1)
  meta          Json?
  deliveryNotes DeliveryNote[]
  branch        Branch           @relation(fields: [branchId], references: [id])
  client        Client?          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer         @relation(fields: [customerId], references: [id])
  issuedBy      User?            @relation(fields: [issuedById], references: [id])
  quotation     Quotation?       @relation(fields: [quotationId], references: [id])
  lines         SalesOrderLine[]

  @@unique([companyId, number])
  @@index([clientId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([quotationId])
  @@index([issuedAt])
  @@index([createdById])
}

model SalesOrderLine {
  id           String           @id @default(uuid())
  salesOrderId String
  productId    String?
  lineNumber   Int              @default(1)
  label        String
  unit         String?
  quantity     Decimal          @default(1)
  unitPrice    Decimal          @default(0)
  discountPct  Decimal          @default(0)
  taxPct       Decimal          @default(0)
  amountHt     Decimal          @default(0)
  amountTva    Decimal          @default(0)
  amountTtc    Decimal          @default(0)
  kind         DocumentLineKind @default(PRODUCT)
  remainingQty Decimal          @default(0)
  product      Product?         @relation(fields: [productId], references: [id])
  salesOrder   SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([productId])
}

model DeliveryNote {
  id           String             @id @default(uuid())
  number       String
