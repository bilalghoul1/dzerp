/// Commande client reçue (bon de commande envoyé par le client à notre société).
/// Document entrant : représente strictement ce que le client a demandé.
/// Distinct de SALES_ORDER (engagement interne après acceptation) et de QUOTATION.
model CustomerOrder {
  id                    String              @id @default(uuid())
  number                String
  status                DocumentStatus      @default(RECEIVED)
  clientId              String?
  branchId              String
  issuedById            String?
  issuedAt              DateTime            @default(now())
  receivedDate          DateTime?
  customerOrderNumber   String?
  customerOrderDate     DateTime?
  requestedDeliveryDate DateTime?
  currency              String              @default("DZD")
  conditions            String?
  notes                 String?
  totalHt               Decimal             @default(0)
  totalTva              Decimal             @default(0)
  totalTtc              Decimal             @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  createdById           String?
  updatedById           String?
  customerId            String
  companyId             String
  exchangeRate          Decimal             @default(1)
  meta                  Json?
  branch                Branch              @relation(fields: [branchId], references: [id])
  client                Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer              Customer            @relation(fields: [customerId], references: [id])
  issuedBy              User?               @relation(fields: [issuedById], references: [id])
  lines                 CustomerOrderLine[]
  proformas             Proforma[]

  @@unique([companyId, number])
  @@index([clientId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([customerOrderNumber])
  @@index([receivedDate])
  @@index([issuedAt])
  @@index([createdById])
}

model CustomerOrderLine {
  id              String           @id @default(uuid())
  customerOrderId String
  productId       String?
  lineNumber      Int              @default(1)
  label           String
  unit            String?
  /// Quantité demandée par le client (NE JAMAIS confondre avec remainingQty de SalesOrderLine).
  quantity        Decimal          @default(1)
  unitPrice       Decimal          @default(0)
  discountPct     Decimal          @default(0)
  taxPct          Decimal          @default(0)
  amountHt        Decimal          @default(0)
  amountTva       Decimal          @default(0)
  amountTtc       Decimal          @default(0)
  kind            DocumentLineKind @default(PRODUCT)
  customerSpecs   String?
  customerOrder   CustomerOrder    @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id])

  @@index([customerOrderId])
  @@index([productId])
}

/// Facture Proforma (offre commerciale sortante émise par notre société).
/// Document distinct de QUOTATION et de INVOICE. Les prix/TVA sont définis
/// par notre société et ne modifient jamais la CustomerOrder source.
model Proforma {
  id              String         @id @default(uuid())
  number          String
  status          DocumentStatus @default(DRAFT)
  clientId        String?
  branchId        String
  customerOrderId String?
  issuedById      String?
  issuedAt        DateTime       @default(now())
  validUntil      DateTime?
  currency        String         @default("DZD")
  conditions      String?
  notes           String?
  totalHt         Decimal        @default(0)
  totalTva        Decimal        @default(0)
  totalTtc        Decimal        @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String?
  updatedById     String?
  customerId      String
  companyId       String
  exchangeRate    Decimal        @default(1)
  meta            Json?
  branch          Branch         @relation(fields: [branchId], references: [id])
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer       @relation(fields: [customerId], references: [id])
  customerOrder   CustomerOrder? @relation(fields: [customerOrderId], references: [id])
  issuedBy        User?          @relation(fields: [issuedById], references: [id])
  lines           ProformaLine[]

  @@unique([companyId, number])
  @@index([clientId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([customerOrderId])
  @@index([validUntil])
  @@index([issuedAt])
  @@index([createdById])
}

