// ============================================================================
// DzERP — Schéma de fondation (Phase 2)
//
// Conventions:
//  - IDs: UUID v4 générés côté client (@default(uuid())).
//  - Audit: chaque entité métier porte createdAt/updatedAt (+ createdById /
//    updatedById / deletedById stockés comme identifiants simples avec index).
//    Les modèles d'infrastructure (Session, AuditLog, ...) utilisent de vraies
//    relations pour l'acteur.
//  - Suppression logique: champ deletedAt (nullable). Voir l'extension client
//    softDelete dans src/lib/db/soft-delete.ts.
//  - Les énumérations partagées sont centralisées ci-dessous.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Énumérations partagées
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DocumentStatus {
  DRAFT
  PENDING
  VALIDATED
  REJECTED
  CANCELLED
  ARCHIVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
  IMPORT
  UPLOAD
  LOGIN
  LOGOUT
  ASSIGN
  REVOKE
  SETTING_CHANGE
}

enum ActivityType {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
  IMPORT
  STATUS_CHANGE
  SETTING_CHANGE
  PERMISSION_CHANGE
  SYSTEM
}

enum FileKind {
  ATTACHMENT
  AVATAR
  DOCUMENT
  EXPORT
  IMPORT
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  SECRET
}

enum BranchType {
  HEADQUARTER
  DIRECTION
  AGENCY
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

enum PartyKind {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum PrintFormat {
  A4
  A5
  THERMAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Multi-établissement
// ---------------------------------------------------------------------------

model Branch {
  id         String     @id @default(uuid())
  code       String     @unique
  name       String
  nameAr     String?
  type       BranchType @default(DIRECTION)
  city       String?
  address    String?
  phone      String?
  email      String?
  manager    String?
  country    String?
  wilaya     String?
  commune    String?
  postalCode String?
  rc         String?
  nif        String?
  nis        String?
  ai         String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  createdById String?
  updatedById String?

  users User[]

  quotations       Quotation[]
  salesOrders      SalesOrder[]
  deliveryNotes    DeliveryNote[]
  invoices         Invoice[]
  creditNotes      CreditNote[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoice[]

  @@index([type])
  @@index([city])
  @@index([wilaya])
}

// ---------------------------------------------------------------------------
// Référentiels (fondation algérienne)
// ---------------------------------------------------------------------------

model Country {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameAr    String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model LegalForm {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameAr    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model BusinessSector {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameAr    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model PaymentMethod {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameAr    String?
  days      Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model Wilaya {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameAr    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  communes Commune[]

  @@index([isActive])
}

model Commune {
  id        String   @id @default(uuid())
  code      String   @unique
  wilayaCode String
  wilaya    Wilaya   @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)
  name      String
  nameAr    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([wilayaCode])
  @@index([isActive])
}

model Bank {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameAr    String?
  swift     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// RBAC — Utilisateurs, Rôles, Permissions
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String?    @unique
  passwordHash String
  fullName     String?
  title        String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String?
  updatedById  String?

  roles     UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]
  activity  ActivityEvent[]
  files     FileAsset[]
  settings  Setting[]
  requestedApprovals DocumentApproval[] @relation("DocumentApprovalRequestedBy")
  decidedApprovals   DocumentApproval[] @relation("DocumentApprovalApprover")

  issuedQuotations       Quotation[]
  issuedSalesOrders      SalesOrder[]
  issuedDeliveryNotes    DeliveryNote[]
  issuedInvoices         Invoice[]
  issuedCreditNotes      CreditNote[]
  issuedPurchaseRequests PurchaseRequest[]
  issuedPurchaseOrders   PurchaseOrder[]
  issuedGoodsReceipts    GoodsReceipt[]
  issuedSupplierInvoices SupplierInvoice[]

  @@index([branchId])
  @@index([status])
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  nameAr      String?
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@index([isSystem])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  name        String
  nameAr      String?
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Sessions (cookie signé + révocabilité)
// ---------------------------------------------------------------------------

model Session {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Paramètres / configuration (architecture "Settings")
// ---------------------------------------------------------------------------

model Setting {
  id          String      @id @default(uuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  description String?
  isPublic    Boolean     @default(false)
  updatedById String?
  updatedBy   User?       @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([isPublic])
}

// ---------------------------------------------------------------------------
// Journal d'audit (traçabilité)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  entity    String
  entityId  String?
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ip        String?
  userAgent String?
  changes   Json?
  createdAt DateTime    @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Fil d'activité (timeline)
// ---------------------------------------------------------------------------

model ActivityEvent {
  id        String       @id @default(uuid())
  type      ActivityType
  actorId   String?
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entity    String
  entityId  String?
  title     String
  titleAr   String?
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Fichiers (abstraction upload)
// ---------------------------------------------------------------------------

model FileAsset {
  id           String   @id @default(uuid())
  originalName String
  storageKey   String   @unique
  mimeType     String
  size         Int
  kind         FileKind @default(ATTACHMENT)
  entity       String
  entityId     String?
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdById])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Numérotation de documents (devis, commandes, factures...)
// ---------------------------------------------------------------------------

model Counter {
  id        String @id @default(uuid())
  key       String @unique
  prefix    String @default("")
  nextValue BigInt @default(1)
  padLength Int    @default(4)
  step      Int    @default(1)
}

// ---------------------------------------------------------------------------
// Entités métier de base (étendues en Phase 3)
// ---------------------------------------------------------------------------

model Client {
  id         String   @id @default(uuid())
  code       String   @unique
  kind       PartyKind @default(CUSTOMER) // tiers : client, fournisseur ou les deux
  type       ClientType @default(COMPANY) // entreprise ou particulier
  name       String
  nameAr     String?
  // Particuliers
  firstName  String?
  lastName   String?
  // Entreprises
  legalName      String?
  commercialName String?
  legalForm      String?
  activity       String?
  sector     String?
  email      String?
  phone      String?
  // Données légales algériennes (optionnelles)
  taxId      String? // NIF
  rc         String?
  nis        String?
  ai         String?
  vatNumber  String?
  address    String?
  wilaya     String?
  commune    String?
  postalCode String?
  // Conditions commerciales
  paymentTerms String?
  creditLimit  Decimal  @default(0)
  notes      String?
  balance    Decimal  @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdById String?
  updatedById String?
  deletedAt  DateTime?
  deletedById String?

  quotations        Quotation[]
  salesOrders       SalesOrder[]
  deliveryNotes     DeliveryNote[]
  invoices          Invoice[]
  creditNotes       CreditNote[]
  purchaseRequests  PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  supplierInvoices  SupplierInvoice[]

  @@index([name])
  @@index([kind])
  @@index([type])
  @@index([sector])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Business partners (independent modules)
// ---------------------------------------------------------------------------

model Customer {
  id            String     @id @default(uuid())
  code          String     @unique
  type          ClientType @default(COMPANY)
  name          String
  nameAr        String?
  firstName     String?
  lastName      String?
  legalName     String?
  commercialName String?
  legalForm     String?
  activity      String?
  sector        String?
  email         String?
  phone         String?
  taxId         String?
  rc            String?
  nis           String?
  ai            String?
  vatNumber     String?
  address       String?
  wilaya        String?
  commune       String?
  postalCode    String?
  paymentTerms  String?
  creditLimit   Decimal    @default(0)
  notes         String?
  balance       Decimal    @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  deletedById   String?

  quotations   Quotation[]
  salesOrders  SalesOrder[]
  deliveryNotes DeliveryNote[]
  invoices     Invoice[]
  creditNotes  CreditNote[]

  @@index([name])
  @@index([type])
  @@index([sector])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdById])
}

model Supplier {
  id            String     @id @default(uuid())
  code          String     @unique
  type          ClientType @default(COMPANY)
  name          String
  nameAr        String?
  firstName     String?
  lastName      String?
  legalName     String?
  commercialName String?
  legalForm     String?
  activity      String?
  sector        String?
  email         String?
  phone         String?
  taxId         String?
  rc            String?
  nis           String?
  ai            String?
  vatNumber     String?
  address       String?
  wilaya        String?
  commune       String?
  postalCode    String?
  paymentTerms  String?
  creditLimit   Decimal    @default(0)
  notes         String?
  balance       Decimal    @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  deletedById   String?

  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoice[]

  @@index([name])
  @@index([type])
  @@index([sector])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdById])
}

model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  nameAr      String?
  unit        String?
  category    String?
  price       Decimal  @default(0)
  stock       Int      @default(0)
  stockMin    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  quotationLines       QuotationLine[]
  salesOrderLines      SalesOrderLine[]
  deliveryNoteLines    DeliveryNoteLine[]
  invoiceLines         InvoiceLine[]
  creditNoteLines      CreditNoteLine[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  supplierInvoiceLines SupplierInvoiceLine[]

  @@index([name])
  @@index([category])
  @@index([deletedAt])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Phase 3 — Documents métier (Ventes / Achats)
//
// Conception :
//  - Relations réelles vers les modèles de fondation (Client, Branch, User,
//    Product) via des champs de rétro-référence ajoutés ci-dessus.
//  - `createdById`/`updatedById` restent des identifiants simples (convention).
//  - Chaque document possède ses lignes (produit, quantité, prix, remise, TVA).
//  - Les modules (devis, commandes, factures...) consommeront ces modèles et
//    la numérotation via `src/features/documents/series.ts`.
// ---------------------------------------------------------------------------

enum DocType {
  QUOTATION
  SALES_ORDER
  DELIVERY_NOTE
  INVOICE
  CREDIT_NOTE
  PURCHASE_REQUEST
  PURCHASE_ORDER
  GOODS_RECEIPT
  SUPPLIER_INVOICE
  CUSTOMER
  SUPPLIER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

// ---------------------------------------------------------------------------
// Numérotation documentaire (séries réutilisables par module)
// ---------------------------------------------------------------------------

model DocumentSeries {
  id         String   @id @default(uuid())
  key        String   @unique // identifiant stable ex. "QUOTATION"
  docType    DocType  @unique // une série active par type de document
  label      String
  labelAr    String?
  prefix     String   @default("")
  separator  String   @default("-")
  suffix     String   @default("")
  withYear   Boolean  @default(true)
  year       Int? // exercice courant ; null = année en cours
  nextValue  BigInt   @default(1)
  padLength  Int      @default(4)
  step       Int      @default(1)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  updatedById String?
}

// ---------------------------------------------------------------------------
// Approbation de documents (workflow réutilisable)
// ---------------------------------------------------------------------------

model DocumentApproval {
  id             String         @id @default(uuid())
  docType        DocType
  docId          String         @unique // identifiant du document ciblé
  requestedById  String?
  requestedBy    User?          @relation("DocumentApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approverId     String?
  approver       User?          @relation("DocumentApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)
  status         ApprovalStatus @default(PENDING)
  comment        String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([docType])
  @@index([status])
  @@index([approverId])
}

// ---------------------------------------------------------------------------
// Ventes
// ---------------------------------------------------------------------------

model Quotation {
  id         String         @id @default(uuid())
  number     String         @unique
  status     DocumentStatus @default(DRAFT)
  clientId   String?
  client     Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId   String
  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  issuedById String?
  issuedBy   User?          @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt   DateTime       @default(now())
  validUntil DateTime?
  currency   String         @default("DZD")
  notes      String?
  totalHt    Decimal        @default(0)
  totalTva   Decimal        @default(0)
  totalTtc   Decimal        @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  createdById String?
  updatedById String?

  lines      QuotationLine[]
  salesOrders SalesOrder[]

  @@index([clientId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([issuedAt])
  @@index([createdById])
}

model QuotationLine {
  id          String  @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  lineNumber  Int     @default(1)
  label       String
  unit        String?
  quantity    Decimal @default(1)
  unitPrice   Decimal @default(0)
  discountPct Decimal @default(0)
  taxPct      Decimal @default(0)
  amountHt    Decimal @default(0)
  amountTva   Decimal @default(0)
  amountTtc   Decimal @default(0)

  @@index([quotationId])
  @@index([productId])
}

model SalesOrder {
  id           String         @id @default(uuid())
  number       String         @unique
  status       DocumentStatus @default(DRAFT)
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  quotationId  String?
  quotation    Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  issuedById   String?
  issuedBy     User?          @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt     DateTime       @default(now())
  deliveryDate DateTime?
  currency     String         @default("DZD")
  notes        String?
  totalHt      Decimal        @default(0)
  totalTva     Decimal        @default(0)
  totalTtc     Decimal        @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String?
  updatedById  String?

  lines        SalesOrderLine[]
  deliveryNotes DeliveryNote[]

  @@index([clientId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([quotationId])
  @@index([issuedAt])
  @@index([createdById])
}

model SalesOrderLine {
  id           String  @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  lineNumber   Int     @default(1)
  label        String
  unit         String?
  quantity     Decimal @default(1)
  unitPrice    Decimal @default(0)
  discountPct  Decimal @default(0)
  taxPct       Decimal @default(0)
  amountHt     Decimal @default(0)
  amountTva    Decimal @default(0)
  amountTtc    Decimal @default(0)

  @@index([salesOrderId])
  @@index([productId])
}

model DeliveryNote {
  id           String         @id @default(uuid())
  number       String         @unique
  status       DocumentStatus @default(DRAFT)
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  salesOrderId String?
  salesOrder   SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  issuedById   String?
  issuedBy     User?          @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt     DateTime       @default(now())
  shippedAt    DateTime?
  currency     String         @default("DZD")
  notes        String?
  totalHt      Decimal        @default(0)
  totalTva     Decimal        @default(0)
  totalTtc     Decimal        @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String?
  updatedById  String?

  lines        DeliveryNoteLine[]

  @@index([clientId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([salesOrderId])
  @@index([issuedAt])
  @@index([createdById])
}

model DeliveryNoteLine {
  id            String  @id @default(uuid())
  deliveryNoteId String
  deliveryNote  DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  lineNumber    Int     @default(1)
  label         String
  unit          String?
  quantity      Decimal @default(1)
  unitPrice     Decimal @default(0)
  discountPct   Decimal @default(0)
  taxPct        Decimal @default(0)
  amountHt      Decimal @default(0)
  amountTva     Decimal @default(0)
  amountTtc     Decimal @default(0)

  @@index([deliveryNoteId])
  @@index([productId])
}

model Invoice {
  id            String        @id @default(uuid())
  number        String        @unique
  status        DocumentStatus @default(DRAFT)
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  issuedById    String?
  issuedBy      User?         @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt      DateTime      @default(now())
  dueDate       DateTime?
  currency      String        @default("DZD")
  notes         String?
  totalHt       Decimal       @default(0)
  totalTva      Decimal       @default(0)
  totalTtc      Decimal       @default(0)
  paidAmount    Decimal       @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?
  updatedById   String?

  lines        InvoiceLine[]
  creditNotes  CreditNote[]

  @@index([clientId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([dueDate])
  @@index([issuedAt])
  @@index([createdById])
