  @@unique([companyId, number])
  @@index([clientId])
  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([dueDate])
  @@index([issuedAt])
  @@index([createdById])
}

model InvoiceLine {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
