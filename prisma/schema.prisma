  createdById    String?
  createdAt      DateTime             @default(now())
  conversionRate Decimal?             @default(1)
  description    String?
  sourceDocType  String
  targetDocType  String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation(fields: [createdById], references: [id])

  @@unique([sourceDocType, sourceDocId, targetDocType, targetDocId])
  @@index([companyId])
  @@index([sourceDocType, sourceDocId])
  @@index([targetDocType, targetDocId])
  @@index([relationType])
}

/// Paiement (encaissement client ou décaissement fournisseur).
/// Montant, date, mode, référence, tiers, société, branche, devise, notes, audit.
/// Le statut de paiement des factures est DÉRIVÉ des allocations (jamais saisi).
model Payment {
  id           String              @id @default(uuid())
  number       String
  companyId    String
  branchId     String
  direction    PaymentDirection    @default(RECEIVED)
  partyKind    PartyKind           @default(CUSTOMER)
  customerId   String?
  supplierId   String?
  methodId     String?
  reference    String?
  paidAt       DateTime            @default(now())
  amount       Decimal             @default(0)
  currency     String              @default("DZD")
  exchangeRate Decimal             @default(1)
  notes        String?
  status       DocumentStatus      @default(VALIDATED)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdById  String?
  updatedById  String?
  meta         Json?
  branch       Branch              @relation(fields: [branchId], references: [id])
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation(fields: [createdById], references: [id])
  customer     Customer?           @relation(fields: [customerId], references: [id])
  method       PaymentMethod?      @relation(fields: [methodId], references: [id])
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  allocations  PaymentAllocation[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([branchId])
  @@index([customerId])
  @@index([supplierId])
  @@index([direction])
  @@index([status])
  @@index([paidAt])
  @@index([methodId])
  @@index([createdById])
}

/// Répartition d'un paiement sur une ou plusieurs factures (vente ou achat).
model PaymentAllocation {
  id                String           @id @default(uuid())
  paymentId         String
  invoiceId         String?
  supplierInvoiceId String?
  amount            Decimal          @default(0)
  createdAt         DateTime         @default(now())
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
  @@index([supplierInvoiceId])
}

/// Compte du plan comptable (nomenclature algérienne simplifiée).
model Account {
  id           String        @id @default(uuid())
  companyId    String
  code         String
  name         String
  nameAr       String?
  type         AccountType   @default(ASSET)
  parentId     String?
  isSystem     Boolean       @default(false)
  isActive     Boolean       @default(true)
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       Account?      @relation("AccountChildren", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountChildren")
  journalLines JournalLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([type])
  @@index([parentId])
  @@index([isActive])
}

/// Période fiscale / exercice comptable.
model FiscalPeriod {
  id             String         @id @default(uuid())
  companyId      String
  label          String
  startDate      DateTime
  endDate        DateTime
  status         String         @default("OPEN")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([companyId, label])
  @@index([companyId])
  @@index([status])
}

/// Écriture comptable (pièce). Double implication : somme(débit)=somme(crédit).
model JournalEntry {
  id             String        @id @default(uuid())
  companyId      String
  number         String
  entryDate      DateTime      @default(now())
  fiscalPeriodId String?
  reference      String?
  description    String?
  sourceDocType  String?
  sourceDocId    String?
  status         String        @default("POSTED")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User?         @relation(fields: [createdById], references: [id])
  fiscalPeriod   FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id])
  lines          JournalLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([entryDate])
  @@index([fiscalPeriodId])
  @@index([sourceDocType, sourceDocId])
  @@index([status])
}

/// Ligne d'écriture (débit OU crédit, jamais les deux).
model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0)
  credit         Decimal      @default(0)
  description    String?
  sourceDocType  String?
  sourceDocId    String?
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([sourceDocType, sourceDocId])
}

/// Cycle de paie (généré par société + période).
model PayrollRun {
  id            String           @id @default(uuid())
  companyId     String
  period        String
  label         String?
  status        PayrollRunStatus @default(DRAFT)
  validatedById String?
  validatedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slips         SalarySlip[]

  @@unique([companyId, period])
  @@index([period])
  @@index([status])
}

/// Bulletin de salaire individuel (lié à un employé et à un cycle).
model SalarySlip {
  id             String           @id @default(uuid())
  companyId      String
  employeeId     String
  payrollRunId   String
  period         String
  baseSalary     Decimal          @default(0)
  seniorityBonus Decimal          @default(0)
  housingBonus   Decimal          @default(0)
  transportBonus Decimal          @default(0)
  otherBonus     Decimal          @default(0)
  grossSalary    Decimal          @default(0)
  irgAmount      Decimal          @default(0)
  cnasAmount     Decimal          @default(0)
  otherDeduction Decimal          @default(0)
  netSalary      Decimal          @default(0)
  employerCnas   Decimal          @default(0)
  employerCasnos Decimal          @default(0)
  employerDas    Decimal          @default(0)
  totalCost      Decimal          @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRun     PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  lines          SalarySlipLine[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@index([period])
}

/// Ligne détaillée du bulletin (libellé, type gain/retenue, montant).
model SalarySlipLine {
  id           String         @id @default(uuid())
  salarySlipId String
  label        String
  labelAr      String?
  kind         SalaryLineKind
  amount       Decimal        @default(0)
  salarySlip   SalarySlip     @relation(fields: [salarySlipId], references: [id], onDelete: Cascade)

  @@index([salarySlipId])
}

/// Barème IRG algérien (tranches mensuelles nettes imposables).
/// `min`/`max` en DZD/mois ; `rate` décimal ; `deductible` = abattement cumulé.
model IrgBracket {
  id         String   @id @default(uuid())
  companyId  String
  min        Decimal
  max        Decimal?
  rate       Decimal
  deductible Decimal  @default(0)
  label      String?
  labelAr    String?
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Configuration des taux de cotisations sociales (par société).
model SocialContributionConfig {
  id                 String  @id @default(uuid())
  companyId          String  @unique
  cnasEmployeeRate   Decimal @default(0.09)
  cnasEmployerRate   Decimal @default(0.26)
  casnosEmployerRate Decimal @default(0.01)
  dasEmployerRate    Decimal @default(0.01)
  company            Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model TaxDeclaration {
  id          String               @id @default(uuid())
  companyId   String
  branchId    String?
  kind        TaxDeclarationKind
  period      String
  status      TaxDeclarationStatus @default(DRAFT)
  baseAmount  Decimal              @default(0) @db.Decimal(18, 4)
  taxAmount   Decimal              @default(0) @db.Decimal(18, 4)
  paidAmount  Decimal              @default(0) @db.Decimal(18, 4)
  dueDate     DateTime?
  submittedAt DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdById String?
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([kind])
  @@index([period])
  @@index([status])
}

model BankReconciliation {
  id               String   @id @default(uuid())
  companyId        String
  bankAccount      String
  period           String
  statementBalance Decimal  @default(0) @db.Decimal(18, 4)
  bookBalance      Decimal  @default(0) @db.Decimal(18, 4)
  difference       Decimal  @default(0) @db.Decimal(18, 4)
  status           String   @default("OPEN")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([period])
}

model FixedAsset {
  id                      String        @id @default(uuid())
  companyId               String
  code                    String
  name                    String
  nameAr                  String?
  category                AssetCategory @default(EQUIPMENT)
  acquisitionDate         DateTime
  acquisitionCost         Decimal       @db.Decimal(18, 4)
  residualValue           Decimal       @default(0) @db.Decimal(18, 4)
  usefulLifeYears         Int           @default(5)
  depreciationMethod      String        @default("LINEAR")
  accumulatedDepreciation Decimal       @default(0) @db.Decimal(18, 4)
  bookValue               Decimal       @db.Decimal(18, 4)
  accountId               String?
  status                  String        @default("ACTIVE")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  company                 Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
  @@index([category])
}

