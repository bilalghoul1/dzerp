generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id               String            @id @default(uuid())
  code             String
  name             String
  nameAr           String?
  type             BranchType        @default(DIRECTION)
  city             String?
  address          String?
  phone            String?
  email            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String?
  updatedById      String?
  ai               String?
  commune          String?
  country          String?
  manager          String?
  nif              String?
  nis              String?
  postalCode       String?
  rc               String?
  wilaya           String?
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultBranchFor Company?          @relation("CompanyDefaultBranch")
  creditNotes      CreditNote[]
  deliveryNotes    DeliveryNote[]
  goodsReceipts    GoodsReceipt[]
  invoices         Invoice[]
  purchaseOrders   PurchaseOrder[]
  purchaseRequests PurchaseRequest[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  sessions         Session[]
  supplierInvoices SupplierInvoice[]
  users            User[]
  userCompanies    UserCompany[]     @relation("UserCompanyDefaultBranch")
  warehouses       Warehouse[]

  @@unique([companyId, code])
  @@index([type])
  @@index([city])
  @@index([wilaya])
}

model Country {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nameAr      String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model LegalForm {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nameAr      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model BusinessSector {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nameAr      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model PaymentMethod {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nameAr      String?
  days        Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model Wilaya {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  nameAr    String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  communes  Commune[]

  @@index([isActive])
}

model Commune {
  id         String   @id @default(uuid())
  code       String   @unique
  wilayaCode String
  name       String
  nameAr     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  wilaya     Wilaya   @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)

  @@index([wilayaCode])
  @@index([isActive])
}

model Bank {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nameAr      String?
  swift       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([isActive])
}

model User {
  id                       String             @id @default(uuid())
  username                 String             @unique
  email                    String?            @unique
  passwordHash             String
  fullName                 String?
  title                    String?
  status                   UserStatus         @default(ACTIVE)
  lastLoginAt              DateTime?
  branchId                 String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  createdById              String?
  updatedById              String?
  activity                 ActivityEvent[]
  auditLogs                AuditLog[]
  companyDrafts            CompanyDraft?
  issuedCreditNotes        CreditNote[]
  issuedDeliveryNotes      DeliveryNote[]
  decidedApprovals         DocumentApproval[] @relation("DocumentApprovalApprover")
  requestedApprovals       DocumentApproval[] @relation("DocumentApprovalRequestedBy")
  createdDocumentRelations DocumentRelation[]
  files                    FileAsset[]
  issuedGoodsReceipts      GoodsReceipt[]
  issuedInvoices           Invoice[]
  issuedPurchaseOrders     PurchaseOrder[]
  issuedPurchaseRequests   PurchaseRequest[]
  issuedQuotations         Quotation[]
  issuedSalesOrders        SalesOrder[]
  sessions                 Session[]
  settings                 Setting[]
  issuedSupplierInvoices   SupplierInvoice[]
  branch                   Branch?            @relation(fields: [branchId], references: [id])
  userCompanies            UserCompany[]
  roles                    UserRole[]
  managedWarehouses        Warehouse[]

  @@index([branchId])
  @@index([status])
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  nameAr      String?
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignments RoleAssignment[]
  permissions RolePermission[]
  users       UserRole[]

  @@index([isSystem])
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  module      String
  name        String
  nameAr      String?
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Company {
  id                 String              @id @default(uuid())
  code               String              @unique
  name               String
  nameAr             String?
  legalName          String?
  legalForm          String?
  activity           String?
  taxId              String?
  rc                 String?
  nis                String?
  ai                 String?
  vatNumber          String?
  address            String?
  country            String?
  wilaya             String?
  commune            String?
  postalCode         String?
  phone              String?
  email              String?
  website            String?
  currency           String              @default("DZD")
  fiscalYear         Int?
  isDefault          Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String?
  updatedById        String?
  bank               String?
  bankAccount        String?
  bankAgency         String?
  capital            Decimal?
  commercialName     String?
  defaultBranchId    String?             @unique
  deletedAt          DateTime?
  deletedById        String?
  emailFooter        String?
  establishedAt      DateTime?
  expiryDate         DateTime?
  iban               String?
  invoiceFooter      String?
  language           String              @default("fr")
  logoKey            String?
  mobile             String?
  notes              String?
  paymentTerms       String?
  primaryColor       String?
  printFormat        String              @default("A4")
  printHeader        String?
  printMargins       Json?
  qrEnabled          Boolean             @default(false)
  rib                String?
  secondaryActivity  String?
  secondaryColor     String?
  signatureKey       String?
  stampKey           String?
  status             CompanyStatus       @default(ACTIVE)
  swift              String?
  type               String?
  activityEvents     ActivityEvent[]
  auditLogs          AuditLog[]
  branches           Branch[]
  brands             Brand[]
  defaultBranch      Branch?             @relation("CompanyDefaultBranch", fields: [defaultBranchId], references: [id])
  creditNotes        CreditNote[]
  customers          Customer[]
  deliveryNotes      DeliveryNote[]
  documentApprovals  DocumentApproval[]
  documentRelations  DocumentRelation[]
  documentSeries     DocumentSeries[]
  fileAssets         FileAsset[]
  goodsReceipts      GoodsReceipt[]
  inventoryMovements InventoryMovement[]
  invoices           Invoice[]
  manufacturers      Manufacturer[]
  products           Product[]
  productCategories  ProductCategory[]
  purchaseOrders     PurchaseOrder[]
  purchaseRequests   PurchaseRequest[]
  quotations         Quotation[]
  salesOrders        SalesOrder[]
  sessions           Session[]
  suppliers          Supplier[]
  supplierInvoices   SupplierInvoice[]
  userCompanies      UserCompany[]
  warehouses         Warehouse[]

  @@index([isActive])
  @@index([isDefault])
  @@index([status])
  @@index([deletedAt])
}

/// Brouillon de création de société (assistant 9 étapes, Phase 5.5).
/// Un seul brouillon actif par utilisateur : sauvegarde partielle des étapes.
model CompanyDraft {
  id        String   @id @default(uuid())
  userId    String   @unique
  step      Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

/// Adhésion d'un utilisateur à une société (Phase 5.3).
/// Un utilisateur peut appartenir à plusieurs sociétés ; une seule adhésion
/// par couple (utilisateur, société) ; exactement une adhésion par défaut par
/// utilisateur.
model UserCompany {
  id              String           @id @default(uuid())
  userId          String
  companyId       String
  active          Boolean          @default(true)
  isDefault       Boolean          @default(false)
  joinedAt        DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  defaultBranchId String?
  roleAssignments RoleAssignment[]
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultBranch   Branch?          @relation("UserCompanyDefaultBranch", fields: [defaultBranchId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([active])
}

/// Rôle attribué à une adhésion société (Phase 5.3).
/// Remplace l'autorisation directe par `UserRole` (rôle global) dans la société
/// active. Prêt pour les permissions temporaires et la délégation (`expiresAt`).
model RoleAssignment {
  id            String      @id @default(uuid())
  userCompanyId String
  roleId        String
  active        Boolean     @default(true)
  assignedBy    String?
  assignedAt    DateTime    @default(now())
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userCompany   UserCompany @relation(fields: [userCompanyId], references: [id], onDelete: Cascade)

  @@unique([userCompanyId, roleId])
  @@index([roleId])
  @@index([active])
}

model Session {
  id              String    @id @default(uuid())
  token           String    @unique
  userId          String
  ip              String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  activeBranchId  String?
  activeCompanyId String?
  activeBranch    Branch?   @relation(fields: [activeBranchId], references: [id])
  activeCompany   Company?  @relation(fields: [activeCompanyId], references: [id])
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeCompanyId])
  @@index([activeBranchId])
}

model Setting {
  id          String      @id @default(uuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  description String?
  isPublic    Boolean     @default(false)
  updatedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  updatedBy   User?       @relation(fields: [updatedById], references: [id])

  @@index([isPublic])
}

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  entity    String
  entityId  String?
  actorId   String?
  ip        String?
  userAgent String?
  changes   Json?
  createdAt DateTime    @default(now())
  companyId String?
  actor     User?       @relation(fields: [actorId], references: [id])
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model ActivityEvent {
  id        String       @id @default(uuid())
  type      ActivityType
  actorId   String?
  entity    String
  entityId  String?
  title     String
  titleAr   String?
  meta      Json?
  createdAt DateTime     @default(now())
  companyId String?
  actor     User?        @relation(fields: [actorId], references: [id])
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model FileAsset {
  id           String   @id @default(uuid())
  originalName String
  storageKey   String   @unique
  mimeType     String
  size         Int
  kind         FileKind @default(ATTACHMENT)
  entity       String
  entityId     String?
  createdById  String?
  createdAt    DateTime @default(now())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([entity, entityId])
  @@index([createdById])
  @@index([kind])
}

model Counter {
  id        String @id @default(uuid())
  key       String @unique
  prefix    String @default("")
  nextValue BigInt @default(1)
  padLength Int    @default(4)
  step      Int    @default(1)
}

model Client {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  nameAr           String?
  sector           String?
  email            String?
  phone            String?
  taxId            String?
  address          String?
  balance          Decimal           @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?
  deletedById      String?
  activity         String?
  ai               String?
  commercialName   String?
  commune          String?
  creditLimit      Decimal           @default(0)
  firstName        String?
  kind             PartyKind         @default(CUSTOMER)
  lastName         String?
  legalForm        String?
  legalName        String?
  nis              String?
  notes            String?
  paymentTerms     String?
  postalCode       String?
  rc               String?
  type             ClientType        @default(COMPANY)
  vatNumber        String?
  wilaya           String?
  creditNotes      CreditNote[]
  deliveryNotes    DeliveryNote[]
  goodsReceipts    GoodsReceipt[]
  invoices         Invoice[]
  purchaseOrders   PurchaseOrder[]
  purchaseRequests PurchaseRequest[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  supplierInvoices SupplierInvoice[]

  @@index([name])
  @@index([kind])
  @@index([type])
  @@index([sector])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdById])
}

model Customer {
  id             String         @id @default(uuid())
  code           String
  type           ClientType     @default(COMPANY)
  name           String
  nameAr         String?
  firstName      String?
  lastName       String?
  legalName      String?
  commercialName String?
  legalForm      String?
  activity       String?
  sector         String?
  email          String?
  phone          String?
  taxId          String?
  rc             String?
  nis            String?
  ai             String?
  vatNumber      String?
  address        String?
  wilaya         String?
  commune        String?
  postalCode     String?
  paymentTerms   String?
  creditLimit    Decimal        @default(0)
  notes          String?
  balance        Decimal        @default(0)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  companyId      String
  creditNotes    CreditNote[]
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveryNotes  DeliveryNote[]
  invoices       Invoice[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]

  @@unique([companyId, code])
  @@index([name])
  @@index([type])
  @@index([sector])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdById])
}

model Supplier {
  id                String            @id @default(uuid())
  code              String
  type              ClientType        @default(COMPANY)
  name              String
  nameAr            String?
  firstName         String?
  lastName          String?
  legalName         String?
  commercialName    String?
  legalForm         String?
  activity          String?
  sector            String?
  email             String?
  phone             String?
  taxId             String?
  rc                String?
  nis               String?
  ai                String?
  vatNumber         String?
  address           String?
  wilaya            String?
  commune           String?
  postalCode        String?
  paymentTerms      String?
  creditLimit       Decimal           @default(0)
  notes             String?
  balance           Decimal           @default(0)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?
  deletedById       String?
  companyId         String
  goodsReceipts     GoodsReceipt[]
  preferredProducts Product[]         @relation("ProductPreferredSupplier")
  productSuppliers  ProductSupplier[]
  purchaseOrders    PurchaseOrder[]
  purchaseRequests  PurchaseRequest[]
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierInvoices  SupplierInvoice[]

  @@unique([companyId, code])
  @@index([name])
  @@index([type])
  @@index([sector])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([createdById])
}

model Product {
  id                   String                  @id @default(uuid())
  sku                  String
  name                 String
  nameAr               String?
  unit                 String?
  category             String?
  price                Decimal                 @default(0)
  stock                Int                     @default(0)
  stockMin             Int                     @default(0)
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  createdById          String?
  updatedById          String?
  deletedAt            DateTime?
  deletedById          String?
  allowNegativeStock   Boolean                 @default(false)
  barcode              String?
  brandId              String?
  categoryId           String?
  code                 String
  costPrice            Decimal                 @default(0)
  costingMethod        CostingMethod           @default(AVERAGE)
  description          String?
  height               Decimal?
  internalReference    String?
  inventoryUnitId      String?
  isArchived           Boolean                 @default(false)
  length               Decimal?
  manufacturerId       String?
  maximumQuantity      Decimal                 @default(0)
  meta                 Json?
  minimumQuantity      Decimal                 @default(0)
  minimumSellingPrice  Decimal                 @default(0)
  notes                String?
  parentId             String?
  preferredSupplierId  String?
  purchasePrice        Decimal                 @default(0)
  purchaseUnitId       String?
  reorderPoint         Decimal                 @default(0)
  retailPrice          Decimal                 @default(0)
  salesUnitId          String?
  sellingPrice         Decimal                 @default(0)
  subcategoryId        String?
  trackInventory       Boolean                 @default(true)
  type                 ProductType             @default(PRODUCT)
  vatCategoryId        String?
  volume               Decimal?
  weight               Decimal?
  wholesalePrice       Decimal                 @default(0)
  width                Decimal?
  companyId            String
  creditNoteLines      CreditNoteLine[]
  deliveryNoteLines    DeliveryNoteLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  inventoryMovements   InventoryMovement[]
  invoiceLines         InvoiceLine[]
  brand                Brand?                  @relation(fields: [brandId], references: [id])
  productCategory      ProductCategory?        @relation("ProductCategory", fields: [categoryId], references: [id])
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryUnit        Unit?                   @relation("ProductInventoryUnit", fields: [inventoryUnitId], references: [id])
  manufacturer         Manufacturer?           @relation(fields: [manufacturerId], references: [id])
  parent               Product?                @relation("ProductVariant", fields: [parentId], references: [id])
  children             Product[]               @relation("ProductVariant")
  preferredSupplier    Supplier?               @relation("ProductPreferredSupplier", fields: [preferredSupplierId], references: [id])
  purchaseUnit         Unit?                   @relation("ProductPurchaseUnit", fields: [purchaseUnitId], references: [id])
  salesUnit            Unit?                   @relation("ProductSalesUnit", fields: [salesUnitId], references: [id])
  productSubcategory   ProductCategory?        @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  vatCategory          VatCategory?            @relation(fields: [vatCategoryId], references: [id])
  attributeValues      ProductAttributeValue[]
  productSuppliers     ProductSupplier[]
  purchaseOrderLines   PurchaseOrderLine[]
  purchaseRequestLines PurchaseRequestLine[]
  quotationLines       QuotationLine[]
  salesOrderLines      SalesOrderLine[]
  supplierInvoiceLines SupplierInvoiceLine[]

  @@unique([companyId, code])
  @@unique([companyId, sku])
  @@index([name])
  @@index([nameAr])
  @@index([type])
  @@index([barcode])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([brandId])
  @@index([manufacturerId])
  @@index([vatCategoryId])
  @@index([preferredSupplierId])
  @@index([parentId])
  @@index([deletedAt])
  @@index([createdById])
}

model ProductCategory {
  id                    String            @id @default(uuid())
  code                  String
  name                  String
  nameAr                String?
  parentId              String?
  isActive              Boolean           @default(true)
  sortOrder             Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  createdById           String?
  updatedById           String?
  companyId             String
  productsAsCategory    Product[]         @relation("ProductCategory")
  productsAsSubcategory Product[]         @relation("ProductSubcategory")
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent                ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children              ProductCategory[] @relation("ProductCategoryTree")

  @@unique([companyId, code])
  @@index([parentId])
  @@index([isActive])
}

model Brand {
  id          String    @id @default(uuid())
  code        String
  name        String
  nameAr      String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, code])
  @@index([isActive])
}

model Manufacturer {
  id          String    @id @default(uuid())
  code        String
  name        String
  nameAr      String?
  country     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, code])
  @@index([isActive])
}

model Unit {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  nameAr         String?
  symbol         String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  inventoryUnits Product[] @relation("ProductInventoryUnit")
  purchaseUnits  Product[] @relation("ProductPurchaseUnit")
  salesUnits     Product[] @relation("ProductSalesUnit")

  @@index([isActive])
}

model VatCategory {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  nameAr      String?
  rate        Decimal   @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  products    Product[]

  @@index([isActive])
}

model ProductAttribute {
  id          String                  @id @default(uuid())
  code        String                  @unique
  name        String
  nameAr      String?
  inputType   AttributeInputType      @default(TEXT)
  options     Json?
