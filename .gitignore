# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite databases
*.db
*.db-journal
*.sqlite

# uploaded files
/uploads

# ============================================================
# SECRETS & CREDENTIALS  (P0 — never commit)
# ============================================================
# Credentials / account / identity dumps
*.txt

# Exported secrets / test payloads / API responses with tokens
*.json
#  -> allow package.json / tsconfig / config json via negation:
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.*.json
!next.config.*.json
!next.config.*.js
!components.json
!src/**/*.json
!prisma/*.json
!public/**/*.json
!scripts/**/*.json

# Logs that may contain tokens / cookies / session ids
*.log
dev-server.log
debug-*.log

# Browser/HTTP captures & HTML dumps (may leak session data)
*.html
h_*.html
home_*.html
ha.html
hb.html
h_anon.html
h_auth.html
h_fr.html
h_ar.html
home_anon.html
home_auth.html

# Local settings / secrets overrides
.secret
.secrets
*.local

# Private keys / certs
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa
id_ed25519

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*~
